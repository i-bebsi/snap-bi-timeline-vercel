# Supabase (Postgres) connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Sesi admin (JWT HS256) — isi dengan string acak panjang
JWT_SECRET=change-me-to-a-long-random-string

# Satu-satunya akun admin (email + hash password bcrypt).
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('PASSWORD',10))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_bcrypt_hash
